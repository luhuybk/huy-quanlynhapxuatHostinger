generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// UserRole is "ADMIN" | "SHARED" | "STAFF", validated at the application layer.
// STAFF (nhân viên): can only see EXPORT transactions for agents they own
// or shared (ownerId null) agents — see Agent.ownerId and lib/get-transactions.ts.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())

  transactions    Transaction[]
  chinaImports    ChinaImport[]
  chinaOrderItems ChinaOrderItem[]
  vnOrders        VnOrder[]
  ownedAgents     Agent[]          @relation("AgentOwner")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  skus         Sku[]
  transactions Transaction[]
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  note      String?
  sortOrder Int      @default(0)
  // null = shared (chung), visible to everyone. Otherwise only that STAFF
  // user (and ADMIN/SHARED) can see this agent and its EXPORT transactions.
  ownerId   String?
  createdAt DateTime @default(now())

  owner        User?         @relation("AgentOwner", fields: [ownerId], references: [id])
  transactions Transaction[]

  @@index([ownerId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  skus     Sku[]
  vnOrders VnOrder[]
}

model Sku {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  // Size tách riêng khỏi name để mã định danh in ra thống nhất
  // ("1 - AKUMA - Clay - 56") và sau này lọc được theo size. Để trống được,
  // nên dữ liệu cũ (size nằm lẫn trong tên) vẫn chạy bình thường.
  size          String?
  brandId       String
  unitsPerCase  Int      @default(1)
  supplierId    String?
  // Khu vực đang chứa hàng. Đây là *thuộc tính* chứ không phải phần của mã:
  // dời hàng sang khu khác chỉ đổi trường này, code vẫn nguyên nên mọi phiếu
  // nhập/xuất cũ không bị vỡ liên kết.
  zoneId        String?
  isQuickCreate Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  brand        Brand             @relation(fields: [brandId], references: [id])
  supplier     Supplier?         @relation(fields: [supplierId], references: [id])
  zone         Zone?             @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  items        TransactionItem[]
  vnOrderItems VnOrderItem[]

  @@index([zoneId])
}

// Mặt bằng một kho, vẽ theo lưới ô vuông. Hình dạng (chữ nhật, chữ L, hay
// hình bất kỳ) không cần code riêng: mỗi ô tự mang một trong ba trạng thái —
// thuộc một khu, là lối đi, hoặc nằm ngoài tường — nên cắt góc nào ra hình nào
// cũng được. Nhiều kho = nhiều dòng ở bảng này.
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  cols      Int      @default(12)
  rows      Int      @default(8)
  // Lưới lưu dạng JSON: mảng 2 chiều theo [hàng][cột], mỗi ô là Zone.id,
  // "aisle" (lối đi) hoặc null (ngoài tường). Lưới chỉ đọc/ghi trọn gói khi
  // sửa sơ đồ, không bao giờ query lẻ từng ô, nên một cột Text gọn hơn hẳn
  // một bảng vài trăm dòng ô vuông.
  layout    String   @db.Text
  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  zones Zone[]
}

// Khu vực trong một kho. code là phần đứng đầu mã định danh hàng hoá
// ("1" trong "1 - AKUMA - Clay - 56") nên phải duy nhất trên toàn hệ thống,
// không chỉ trong một kho — có nhiều kho thì đặt kiểu "A1", "B3" để nhìn mã
// là biết hàng nằm kho nào.
model Zone {
  id          String   @id @default(cuid())
  warehouseId String
  code        String   @unique
  name        String?
  color       String   @default("teal")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  skus      Sku[]

  @@index([warehouseId])
}

// SQLite has no native enum support; TransactionType is "IMPORT" | "EXPORT"
// and UnitType is "CASE" | "UNIT", validated at the application layer.

model Transaction {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String
  date        DateTime
  supplierId  String?
  agentId     String?
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  // IMPORT-only status flags
  paidDebt          Boolean @default(false)
  receivedWarehouse Boolean @default(false)

  // EXPORT-only status flags
  goodsShipped Boolean @default(false)
  paid         Boolean @default(false)
  settled      Boolean @default(false)

  supplier  Supplier?         @relation(fields: [supplierId], references: [id])
  agent     Agent?            @relation(fields: [agentId], references: [id])
  createdBy User              @relation(fields: [createdById], references: [id])
  items     TransactionItem[]

  @@index([type, date])
}

model TransactionItem {
  id              String  @id @default(cuid())
  transactionId   String
  skuId           String
  unitType        String
  quantityInput   Int
  quantityUnits   Int
  matchedQuantity Boolean @default(false)
  matchedDebt     Boolean @default(false)
  note            String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sku         Sku         @relation(fields: [skuId], references: [id])
}

// Nhập hàng Trung: simplified import flow with free-text item names —
// no Brand/Sku catalog and no Supplier link.
model ChinaImport {
  id          String   @id @default(cuid())
  code        String   @unique
  date        DateTime
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  createdBy User              @relation(fields: [createdById], references: [id])
  items     ChinaImportItem[]

  @@index([date])
}

model ChinaImportItem {
  id            String  @id @default(cuid())
  chinaImportId String
  itemName      String
  quantity      Int
  note          String?

  chinaImport ChinaImport @relation(fields: [chinaImportId], references: [id], onDelete: Cascade)
}

// Đợt order hàng Việt Nam — hàng VN thường đặt theo từng brand, nên mỗi đợt
// gắn với đúng 1 Brand và chứa nhiều món. Trạng thái đã đặt / đã về tính cho
// cả đợt. Tương ứng tab "Hàng order Việt Nam" trong /hang-can-order.
model VnOrder {
  id          String   @id @default(cuid())
  code        String   @unique
  date        DateTime
  brandId     String
  note        String?
  ordered     Boolean  @default(false)
  arrived     Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  brand     Brand         @relation(fields: [brandId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     VnOrderItem[]

  @@index([brandId])
  @@index([ordered])
}

model VnOrderItem {
  id        String  @id @default(cuid())
  vnOrderId String
  // Trỏ tới SKU có sẵn khi chọn từ danh mục; null khi gõ tên hàng mới tự do.
  skuId     String?
  itemName  String
  quantity  Int
  note      String?

  vnOrder VnOrder @relation(fields: [vnOrderId], references: [id], onDelete: Cascade)
  sku     Sku?    @relation(fields: [skuId], references: [id])

  @@index([vnOrderId])
  @@index([skuId])
}

// Danh sách hàng Trung cần order (chưa lên phiếu nhập) — tách riêng khỏi
// ChinaImport để không lẫn với các phiếu đã nhập thật.
model ChinaOrderItem {
  id          String   @id @default(cuid())
  itemName    String
  quantity    Int
  note        String?
  ordered     Boolean  @default(false)
  arrived     Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([ordered])
  @@index([arrived])
}
